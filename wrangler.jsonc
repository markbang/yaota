{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaota",
  "main": "./worker.ts",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
   "observability": {
    "logs": {
      "enabled": false,
      "head_sampling_rate": 0.01,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "routes": [{ "pattern": "mobile.talesofai.com", "custom_domain": true }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cohub-ota-updates",
    "database_id": "80ad1cc2-817e-4db8-acc0-d72a994d9c6e"
  }],
  "r2_buckets": [{
    "binding": "ASSETS_R2",
    "bucket_name": "expo-updates"
  }]
}
