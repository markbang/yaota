{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaota",
  "main": "./worker.ts",
  "compatibility_date": "2025-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "OTA_APP_ID": "cohub-mobile" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Uncomment after creating the resources with `wrangler d1 create` and your R2 bucket.
  // "d1_databases": [{
  //   "binding": "DB",
  //   "database_name": "yaota",
  //   "database_id": "replace-with-d1-id"
  // }],
  // "r2_buckets": [{
  //   "binding": "ASSETS_R2",
  //   "bucket_name": "yaota-assets"
  // }]
}
